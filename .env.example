# ─── Production hardening checklist ──────────────────────────────────────────
# Before a service serves real data, confirm on Render (Prod and Staging):
#   1. APP_ENV=production   — enables HSTS, the secure refresh cookie, and the
#      SECRET_KEY guard, and hides /docs, /redoc, /openapi.json.
#   2. SECRET_KEY is a real random value (openssl rand -hex 32), not "changeme".
#      The app refuses to start in production if it's left as the default.
#   3. ALLOWED_ORIGINS lists only the real frontend origin(s) — no localhost, no "*".

# ─── App ─────────────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development

# REQUIRED in production. Generate with: openssl rand -hex 32
# The app refuses to start when APP_ENV=production and this is left as the default.
SECRET_KEY=changeme

HOST=127.0.0.1
PORT=8000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the React frontend.
# Development default is the Vite dev server.
# Production: set to your actual frontend URL (e.g. https://app.example.com)
ALLOWED_ORIGINS=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase transaction pooler URL (port 6543). Grab the full URI from:
#   Supabase dashboard → project/branch → Connect → Transaction pooler
#
# Two databases are wired up via Supabase branching (see CLAUDE.md):
#   - Prod   — project ref bupibumcqijqpsqisslg, tied to git `main`, used by Render prod
#   - Stage  — project ref fkolwbrvxvmmcukkxvgy, tied to git `dev`,  used by Render staging
# Each branch has its own password — copy it from the dashboard for the branch you want.
# Local dev should normally point at stage; only swap to prod when intentionally targeting prod data.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres
#
# SQLite (local dev / testing only — requires aiosqlite):
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# ─── AI ──────────────────────────────────────────────────────────────────────
# Obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── PII / PCI scrubbing ─────────────────────────────────────────────────────
# Statement text is redacted before it is sent to Anthropic (see
# backend/app/services/scrub.py). The regex rules find structured identifiers —
# account numbers, card PANs, SSNs, phones, addresses, ZIPs — on their own.
# Names have no structure, so list yours literally here, comma-separated.
# Include every spelling that appears on a paystub or statement.
PII_IDENTITY_TERMS=

# Escape hatch: set false ONLY to diagnose an extraction regression caused by
# over-redaction. False sends raw statement text to Anthropic.
SCRUB_BEFORE_LLM=true

# ─── Logging ─────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Apple Push Notifications (Phase 6, iOS app) ─────────────────────────────
# All four key/team/bundle/.p8 values must be set for the backend to actually
# send pushes; otherwise notify_user() is a graceful no-op.
# Also requires `uv add 'httpx[http2]'` for HTTP/2 transport.
#
# Generate the .p8 key:
#   Apple Developer portal → Keys → "+" → enable APNs → download Auth Key
#   Paste the file contents below with literal `\n` between PEM lines so it
#   fits in a single env var (Render's UI supports multi-line, .env files
#   don't).
APNS_AUTH_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tascoma.personalfinanceai
# True for Debug/Staging builds (APNs sandbox); False for TestFlight/App Store.
APNS_USE_SANDBOX=true
